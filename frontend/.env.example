# Base URL for API calls at build time. Defaults to the relative "/api/v1",
# which the bundled nginx reverse-proxies to the backend — so the production
# image works unchanged. Only set this for a non-proxied/cross-origin API.
# VITE_API_URL=https://api.example.com/api/v1

# Dev-only: where `npm run dev` proxies /api to. Defaults to http://localhost:8000.
# VITE_API_TARGET=http://localhost:8000
